# 後端服務埠號
PORT=3008

# 前端來源(CORS 白名單)
WEB_ORIGIN=http://localhost:5173

# PostgreSQL 連線設定
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=jp_word

# 開發時可設 true 讓 TypeORM 自動同步 schema(正式環境請用 migration,設為 false)
DB_SYNCHRONIZE=true

# ── 登入與權限 ─────────────────────────────────────
# 簽發 JWT 的密鑰。正式環境「必須」設定,否則服務會拒絕啟動。
# 產生方式:node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me
# token 有效期(秒),預設 7 天;到期就要重新登入
JWT_TTL_SEC=604800
# 存放 token 的 httpOnly cookie 名稱
AUTH_COOKIE_NAME=jp_word_token

# 第一位管理員帳號(啟動時若不存在會自動建立;留空則不建立)
# 沒有這個帳號就沒有人能進權限管理,建議至少設定一次
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=管理員

# ── Redis(選用的加速層)────────────────────────
# 沒設定就整套停用,服務照常運作(直接查資料庫)
REDIS_URL=redis://localhost:6380
# 使用者權限快取存活秒數(短 TTL 當作漏清快取時的安全網)
REDIS_AUTH_TTL_SEC=60
# 排行榜列表快取存活秒數
REDIS_LEADERBOARD_TTL_SEC=30
# 登入速率限制:時間窗內允許的嘗試次數與窗格長度(秒)
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SEC=300

# ── 以下為「部署」用(本機開發可忽略)─────────────────
# 執行環境:production 時後端會一併托管前端 build 產物
# NODE_ENV=production
# 雲端平台提供的單一連線字串;有值時優先於上面的個別 DB_ 欄位
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# 代管 Postgres(如 Neon)需要 SSL 時設 true;Zeabur 內網 Postgres 通常免
# DB_SSL=false
# 為 true 時,啟動若資料庫是空的就自動灌種子(部署 Demo 方便用)
# AUTO_SEED=true
